---
type Props = {
  placement: string;
  wide?: boolean;
};

const { placement, wide = false } = Astro.props;
const sizes = wide ? "250x250,300x250,336x280,728x90" : "250x250,300x250,336x280";
---

<aside class:list={["ad-placement", { "ad-placement-wide": wide }]} aria-label="Publicité" data-ad-placement={placement}>
  <span class="ad-label">Publicité</span>
  <div class="ezoicad" data-sizes={sizes} data-fluid="false" data-required="false"></div>
</aside>

<style>
  .ad-placement {
    width: 100%;
    min-width: 0;
    text-align: center;
  }

  .ad-placement-wide {
    width: min(1120px, calc(100% - 28px));
    margin-inline: auto;
  }

  .ad-label {
    display: none;
    color: #64748b;
    font: 400 0.7rem/1.5 system-ui, sans-serif;
    letter-spacing: 0.06em;
  }

  .ad-placement:has(.ezoicad:not(:empty)) {
    margin-block: 1.5rem;
  }

  .ad-placement:has(.ezoicad:not(:empty)) .ad-label {
    display: block;
    margin-bottom: 0.5rem;
  }
</style>
