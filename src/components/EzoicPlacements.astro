<script is:inline>
  (() => {
    const placements = document.querySelectorAll(".ezoicad");
    if (!placements.length) return;

    window.ezstandalone = window.ezstandalone || {};
    window.ezstandalone.cmd = window.ezstandalone.cmd || [];
    window.ezstandalone.cmd.push(function () {
      // Keep ads in the content, clear of the game and its controls.
      window.ezstandalone.config({
        disableInterstitial: true,
        disableVideo: true,
        disableLeftSideRail: true,
        disableRightSideRail: true,
        disableSidebarFloating: true,
      });
      window.ezstandalone.setEzoicAnchorAd(false);

      placements.forEach((placement) => {
        // Article columns can be narrower than the visitor's screen.
        const sizes = placement.dataset.sizes.split(",").filter((size) =>
          Number(size.split("x")[0]) <= placement.clientWidth
        );
        if (sizes.length) {
          placement.dataset.sizes = sizes.join(",");
          placement.setAttribute("data-ezoic-ready", "");
        }
      });

      if (document.querySelector(".ezoicad[data-ezoic-ready]")) {
        window.ezstandalone.showAds(".ezoicad[data-ezoic-ready]");
      }
    });
  })();
</script>
