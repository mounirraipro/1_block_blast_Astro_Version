---
import { ADSTERRA_ENABLED } from "@/data/advertising";
type Props = { socialBar?: boolean };
const { socialBar = false } = Astro.props;
---
{ADSTERRA_ENABLED && (
<details id="advertising-preferences" class="advertising-preferences" aria-label="Choix publicitaires" data-adsterra-preferences data-social-bar={socialBar ? "true" : "false"}>
  <summary>Choix publicitaires</summary>
  <p>Ce site charge automatiquement des publicités Adsterra et leurs technologies de suivi, sauf si vous les avez désactivées. Vous pouvez modifier ce réglage sur cet appareil.</p>
  <div class="advertising-actions">
    <button type="button" data-adsterra-allow hidden>Réactiver les publicités</button>
    <button type="button" data-adsterra-deny>Désactiver les publicités</button>
    <a href="/privacy-policy/#adsterra">En savoir plus</a>
  </div>
  <p role="status" data-adsterra-status>Les réglages publicitaires de cet appareil sont en cours de lecture.</p>
  <noscript>JavaScript est désactivé : les scripts publicitaires ne sont pas chargés.</noscript>
</details>
)}
<script>
  import { initializeAdsterra } from "../scripts/adsterra";
  initializeAdsterra();
</script>
<style>
  .advertising-preferences { width: min(1120px, calc(100% - 48px)); margin: 0.75rem auto; padding: 0.75rem 0; border-top: 1px solid #e2e8f0; scroll-margin-top: 7rem; }
  .advertising-preferences summary { cursor: pointer; font-size: 0.8rem; color: #64748b; }
  .advertising-preferences p { font-size: 0.85rem; line-height: 1.6; margin: 0.65rem 0; }
  .advertising-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .advertising-actions button { padding: 0.6rem 1rem; border: 1px solid #94a3b8; border-radius: 5px; color: #334155; background: #fff; cursor: pointer; }
  .advertising-actions a { font-size: 0.85rem; text-decoration: underline; }
  @media (max-width: 600px) { .advertising-preferences { width: calc(100% - 28px); } }
</style>
